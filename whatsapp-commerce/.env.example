# ---- Server ----
PORT=3000
# Public HTTPS URL of this service (used to build webhook / tool URLs shown in the dashboard)
PUBLIC_URL=https://wa.rcshopper.com
# SQLite database file
DATABASE_PATH=./data/whatsapp-commerce.db
# 32+ char secret used to encrypt tenant credentials at rest (AES-256-GCM). KEEP SAFE.
ENCRYPTION_KEY=change-me-to-a-long-random-string-at-least-32-chars
# Super-admin key: creates / manages tenants (you, the reseller)
SUPER_ADMIN_KEY=change-me-super-admin-key

# ---- Defaults applied to new tenants (each tenant can override) ----
DIFY_BASE_URL=https://dify.rcshopper.com/v1
# Meta Graph API version
WHATSAPP_GRAPH_VERSION=v21.0
# Shopify Admin API version
SHOPIFY_API_VERSION=2025-07

# ---- Dify auto-setup: this service creates each client's AI chatbot in your Dify ----
DIFY_CONSOLE_URL=https://dify.rcshopper.com
# Option A (recommended): Dify admin API key. In Dify's docker/.env set
#   ADMIN_API_KEY_ENABLE=true
#   ADMIN_API_KEY=<long random string>
# restart Dify, then put the same key + your workspace ID here (Dify → Settings → Members URL / or ask in dashboard).
DIFY_ADMIN_API_KEY=
DIFY_WORKSPACE_ID=
# Option B: a Dify login (owner/admin of the workspace)
DIFY_CONSOLE_EMAIL=
DIFY_CONSOLE_PASSWORD=
# Optional default model "provider|model" (otherwise the Dify workspace default LLM is used)
# e.g. langgenius/openai/openai|gpt-4o-mini   or   langgenius/openrouter/openrouter|openai/gpt-4o-mini
DIFY_DEFAULT_MODEL=

# ---- Selling it: self-serve sign-up + your subscription billing (Stripe Billing) ----
SIGNUP_ENABLED=true
TRIAL_DAYS=14
PLATFORM_STRIPE_SECRET_KEY=
PLATFORM_STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs (recurring) for each plan
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# ---- Meta Embedded Signup (clients connect their WhatsApp number in a few clicks) ----
# Requires your Meta app to be a WhatsApp Tech Provider. Webhook (app level): https://<PUBLIC_URL>/webhooks/whatsapp
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=

# ---- Operations ----
# Errors and job failures are POSTed here as JSON {text} (Slack / Discord / n8n webhook)
ALERT_WEBHOOK_URL=
BACKUP_DIR=./data/backups
BACKUP_KEEP=14
# Charge UK VAT automatically on your subscriptions (turn on Stripe Tax in your Stripe dashboard first)
STRIPE_AUTOMATIC_TAX=false
SUPPORT_EMAIL=

# ---- Direct AI mode (no Dify): any OpenAI-compatible API – OpenRouter by default ----
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini
# OpenRouter: only route to these providers (named sub-processors) and never to ones that log/train on data
AI_PROVIDER_ORDER=openai
AI_ZERO_RETENTION=true
# Optional semantic search for the knowledge base (OpenAI-compatible /embeddings). Empty = keyword search only.
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=

# ---- Legal pages (/legal/terms, /legal/privacy, /legal/dpa) – templates, have a solicitor review ----
PRODUCT_NAME=WhatsApp Commerce
LEGAL_COMPANY_NAME=
LEGAL_COMPANY_NUMBER=
LEGAL_ADDRESS=
LEGAL_CONTACT_EMAIL=
